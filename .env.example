# Deliberate development deployments may use test keys. Production must use pk_live_... / sk_live_...
VITE_CLERK_DEPLOYMENT_MODE=development
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_DEPLOYMENT_MODE=development
CLERK_SECRET_KEY=sk_test_...
# Optional: use Clerk's PEM public key for networkless token verification.
CLERK_JWT_KEY=
# Comma-separated exact frontend origins. Set this in production.
# Local development origin. Production must contain the exact HTTPS app origin.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
NEON_DATABASE_URL=postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require
RESEND_API_KEY=re_...
INVOICE_FROM_EMAIL=CRM Pro <invoices@example.com>
# Phase 7 internal email. The current provider adapter supports Resend.
CRM_EMAIL_PROVIDER=resend
CRM_FROM_EMAIL=CRM Pro <sales@example.com>
# Phase 7 Google Calendar OAuth. Register the exact callback URL in Google Cloud.
APP_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/integrations/google-calendar/callback
# Generate once with: openssl rand -base64 32
# Rotating this key requires re-authorizing every stored integration.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
